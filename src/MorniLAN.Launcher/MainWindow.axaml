<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MorniLAN.Launcher"
        x:Class="MorniLAN.Launcher.MainWindow"
        x:DataType="local:LauncherViewModel"
        Title="MorniLAN"
        Icon="avares://MorniLAN.Launcher/Assets/mornilan.ico"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115">
  <!-- M5: Vollbild-Launcher mit Profilen, Suche, „Zuletzt gespielt“, Leiste und Controller-Bedienung -->
  <Window.Styles>
    <Style Selector="Button.tile">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,18,18" />
      <Setter Property="Background" Value="#1A1E26" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="3" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.tile:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#262B35" />
    </Style>
    <Style Selector="Button.tile:focus /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#4C8DFF" />
      <Setter Property="Background" Value="#262B35" />
    </Style>
    <Style Selector="Button.bar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="#E8EAF0" />
    </Style>
    <Style Selector="Button.bar:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="#262B35" />
      <Setter Property="BorderBrush" Value="#4C8DFF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.dialog">
      <Setter Property="MinWidth" Value="160" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.dialog:focus /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="#4C8DFF" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#9AA3B2" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">
    <Panel x:Name="ContentArea" Background="{Binding Background}">
      <!-- Eigenes Hintergrundbild des Profils, dezent abgedunkelt für Lesbarkeit -->
      <Image Source="{Binding BackgroundImage}" IsVisible="{Binding HasBackgroundImage}" Stretch="UniformToFill" />
      <Panel IsVisible="{Binding HasBackgroundImage}" Background="#99000000" />

      <!-- Fernzugriff: immer deutlich sichtbar, ganz oben -->
      <Border IsVisible="{Binding ShowRemoteBanner}" VerticalAlignment="Top" Background="#C8463D" Padding="20,12"
              ZIndex="50">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="●" FontSize="16" Foreground="White" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding RemoteBanner}" Margin="12,0" FontSize="16" FontWeight="SemiBold"
                     Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" IsVisible="{Binding RemoteAsking}">
            <Button Content="Ablehnen" Command="{Binding DenyRemoteCommand}" />
            <Button Content="Erlauben" Classes="accent" Command="{Binding AllowRemoteCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Begrüßung / Hinweis -->
      <StackPanel IsVisible="{Binding IsWelcome}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="MorniLAN" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#E8EAF0" />
        <TextBlock Text="{Binding WelcomeText}" FontSize="18" HorizontalAlignment="Center" Foreground="#9AA3B2"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="640" />

        <!-- Panel-Adresse von Hand, falls die automatische Suche scheitert -->
        <Border Margin="0,20,0,0" Padding="22,18" CornerRadius="12" Background="#1A1E26" MaxWidth="560"
                HorizontalAlignment="Center">
          <StackPanel Spacing="10">
            <TextBlock Text="Panel nicht gefunden?" FontWeight="SemiBold" Foreground="#E8EAF0"
                       HorizontalAlignment="Center" />
            <TextBlock Foreground="#9AA3B2" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                       Text="Gib die Adresse des Admin-PCs ein – sie steht im Panel unter „Neuen PC hinzufügen“." />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <TextBox Text="{Binding AdminHostInput}" Width="280" PlaceholderText="z. B. 192.168.1.50" />
              <Button Content="Verbinden" Classes="accent" Command="{Binding SubmitAdminHostCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding ConnectionMessage}" Foreground="#3DDC84" HorizontalAlignment="Center"
                       FontSize="13" IsVisible="{Binding HasConnectionMessage}" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Koppeln -->
      <StackPanel IsVisible="{Binding IsPairing}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="MorniLAN" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#E8EAF0" />
        <Border Margin="0,28,0,0" Padding="32,24" CornerRadius="14" Background="#1A1E26" BorderBrush="#4C8DFF"
                BorderThickness="1" HorizontalAlignment="Center">
          <StackPanel Spacing="10" HorizontalAlignment="Center">
            <TextBlock Text="Diesen PC koppeln" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Foreground="#E8EAF0" />
            <TextBlock Text="{Binding PairingHint}" FontSize="15" HorizontalAlignment="Center" Foreground="#9AA3B2"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
            <TextBlock Text="{Binding PairingCode}" FontSize="64" FontWeight="Bold" FontFamily="Consolas, monospace"
                       HorizontalAlignment="Center" Foreground="#E8EAF0" LetterSpacing="4" />
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Wer spielt? -->
      <StackPanel x:Name="ProfilesView" IsVisible="{Binding IsProfiles}" HorizontalAlignment="Center"
                  VerticalAlignment="Center" Spacing="36">
        <TextBlock Text="Wer spielt?" FontSize="44" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#E8EAF0" />
        <WrapPanel HorizontalAlignment="Center" MaxWidth="1200">
          <ItemsControl ItemsSource="{Binding Profiles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:ProfileTile">
                <Button Classes="tile profile" Width="180" Height="220" AutomationProperties.Name="{Binding Name}"
                        Command="{Binding $parent[Window].((local:LauncherViewModel)DataContext).SelectProfileCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="110" Height="110" CornerRadius="55" Background="{Binding Brush}" HorizontalAlignment="Center"
                            ClipToBounds="True">
                      <Panel>
                        <TextBlock Text="{Binding Initial}" FontSize="52" FontWeight="Bold" Foreground="#0F1115"
                                   IsVisible="{Binding !HasAvatar}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding Avatar}" IsVisible="{Binding HasAvatar}" Stretch="UniformToFill" />
                      </Panel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                      <TextBlock Text="🔒" FontSize="16" IsVisible="{Binding HasPassword}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Foreground="#E8EAF0"
                                 TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Classes="tile" Width="180" Height="220" IsVisible="{Binding CanCreateProfile}"
                  AutomationProperties.Name="Neues Profil" Command="{Binding OpenNewProfileCommand}">
            <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border Width="110" Height="110" CornerRadius="55" BorderBrush="#5C6575" BorderThickness="3"
                      HorizontalAlignment="Center">
                <TextBlock Text="+" FontSize="60" Foreground="#9AA3B2" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Neues Profil" FontSize="20" Foreground="#9AA3B2" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </WrapPanel>
        <Button Classes="dialog" HorizontalAlignment="Center" IsVisible="{Binding CanContinueWithoutProfile}"
                Content="Weiter ohne Profil" Command="{Binding ContinueWithoutProfileCommand}" />
      </StackPanel>

      <!-- Passwortabfrage -->
      <StackPanel x:Name="PasswordView" IsVisible="{Binding IsPassword}" HorizontalAlignment="Center"
                  VerticalAlignment="Center" Spacing="18" Width="420">
        <TextBlock Text="{Binding PasswordPrompt}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"
                   Foreground="#E8EAF0" TextAlignment="Center" />
        <TextBox x:Name="PasswordBox" Text="{Binding PasswordInput}" PasswordChar="●" FontSize="20"
                 HorizontalContentAlignment="Center" PlaceholderText="Passwort" />
        <TextBlock Text="{Binding PasswordError}" Foreground="#FF6B6B" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Classes="dialog" Content="Zurück" Command="{Binding BackCommand}" />
          <Button Classes="dialog accent" Content="Öffnen" Command="{Binding ConfirmPasswordCommand}" />
        </StackPanel>
      </StackPanel>

      <!-- Kacheln -->
      <ScrollViewer x:Name="HomeView" IsVisible="{Binding IsHome}" Padding="48,32,30,16">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Classes="bar" Command="{Binding SwitchProfileCommand}" AutomationProperties.Name="Profil wechseln"
                    ToolTip.Tip="Profil wechseln">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="44" Height="44" CornerRadius="22" Background="{Binding ProfileBrush}">
                  <TextBlock Text="{Binding ProfileInitial}" FontSize="22" FontWeight="Bold" Foreground="#0F1115"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding ProfileName}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Classes="bar" Margin="12,0" VerticalAlignment="Center" IsVisible="{Binding HasProfile}"
                    Command="{Binding OpenEditProfileCommand}" AutomationProperties.Name="Mein Profil einrichten"
                    Content="Mein Profil" ToolTip.Tip="Farbe, Hintergrund, Avatar und Passwort" />
            <TextBox x:Name="SearchBox" Grid.Column="2" Width="360" Text="{Binding SearchText}" FontSize="16"
                     PlaceholderText="Suchen …  (Y am Controller)" VerticalAlignment="Center" />
          </Grid>

          <TextBlock IsVisible="{Binding NothingFound}" Text="Nichts gefunden." FontSize="18" Foreground="#9AA3B2" />

          <StackPanel Spacing="12" IsVisible="{Binding HasRecent}">
            <TextBlock Text="Zuletzt gespielt" Classes="section" />
            <ItemsControl ItemsSource="{Binding Recent}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LauncherTile">
                  <Button Classes="tile" Width="240" Height="135" AutomationProperties.Name="{Binding Name}"
                          ToolTip.Tip="{Binding Name}"
                          Command="{Binding $parent[Window].((local:LauncherViewModel)DataContext).LaunchCommand}"
                          CommandParameter="{Binding}">
                    <Panel Background="#15181E">
                      <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                      <StackPanel IsVisible="{Binding !HasCover}" Spacing="8" VerticalAlignment="Center"
                                  HorizontalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="48" Height="48" IsVisible="{Binding HasIcon}" />
                        <TextBlock Text="{Binding Name}" Foreground="#E8EAF0" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                      </StackPanel>
                      <Border Background="#CC0F1115" VerticalAlignment="Bottom" Padding="10,6" IsVisible="{Binding HasCover}">
                        <TextBlock Text="{Binding Name}" Foreground="#E8EAF0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      </Border>
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding HasGames}">
            <TextBlock Text="Spiele" Classes="section" />
            <ItemsControl ItemsSource="{Binding Games}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LauncherTile">
                  <Button Classes="tile" Width="180" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Name}"
                          Command="{Binding $parent[Window].((local:LauncherViewModel)DataContext).LaunchCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel>
                      <Panel Height="270" Background="#15181E">
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                        <StackPanel IsVisible="{Binding !HasCover}" Spacing="12" Margin="14"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                          <Image Source="{Binding Icon}" Width="64" Height="64" IsVisible="{Binding HasIcon}" />
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontSize="16"
                                     Foreground="#E8EAF0" />
                        </StackPanel>
                      </Panel>
                      <TextBlock Text="{Binding Name}" Margin="12,10" FontWeight="SemiBold" Foreground="#E8EAF0"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="12" IsVisible="{Binding HasApps}">
            <TextBlock Text="Apps" Classes="section" />
            <ItemsControl ItemsSource="{Binding Apps}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:LauncherTile">
                  <Button Classes="tile" Width="150" Height="130" AutomationProperties.Name="{Binding Name}"
                          ToolTip.Tip="{Binding Name}"
                          Command="{Binding $parent[Window].((local:LauncherViewModel)DataContext).LaunchCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                      <Panel Width="48" Height="48" HorizontalAlignment="Center">
                        <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                        <Border IsVisible="{Binding !HasIcon}" CornerRadius="10" Background="#262B35">
                          <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="#9AA3B2"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </Panel>
                      <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                 MaxWidth="130" Foreground="#E8EAF0" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>

      <!-- Nachricht vom Admin: Pop-up unten rechts (wie bei einer Fernwartung) -->
      <Border IsVisible="{Binding ShowMessage}" VerticalAlignment="Bottom" HorizontalAlignment="Right"
              Margin="0,0,24,24" Width="380" Background="#1A1E26" BorderBrush="#4C8DFF" BorderThickness="1"
              CornerRadius="12" Padding="18,16" ZIndex="60" BoxShadow="0 8 24 0 #80000000">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="26" Height="26" CornerRadius="13" Background="#4C8DFF" VerticalAlignment="Top">
              <TextBlock Text="M" FontWeight="Bold" Foreground="#0F1115" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding MessageTitle}" FontSize="16" FontWeight="Bold"
                       Foreground="#E8EAF0" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="✕" Padding="8,2" Background="Transparent" Foreground="#9AA3B2"
                    VerticalAlignment="Top" Command="{Binding DismissMessageCommand}" AutomationProperties.Name="Schließen" />
          </Grid>
          <TextBlock Text="{Binding MessageText}" Foreground="#E8EAF0" TextWrapping="Wrap" />
          <Button Content="OK" HorizontalAlignment="Right" Classes="accent" Command="{Binding DismissMessageCommand}" />
        </StackPanel>
      </Border>

      <!-- Dialoge über allem -->
      <Panel x:Name="Overlay" IsVisible="{Binding HasOverlay}" Background="#CC05080E">
        <Border IsVisible="{Binding ShowNewProfile}" x:Name="NewProfileDialog" Background="#1A1E26" CornerRadius="16"
                Padding="36,30" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
          <StackPanel Spacing="18">
            <TextBlock Text="Neues Profil" FontSize="28" FontWeight="Bold" Foreground="#E8EAF0" />
            <TextBox x:Name="NewProfileNameBox" Text="{Binding NewProfileName}" FontSize="20" PlaceholderText="Dein Name"
                     MaxLength="24" />
            <TextBlock Text="Farbe" Foreground="#9AA3B2" />
            <ItemsControl ItemsSource="{Binding Colors}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:ColorChoice">
                  <Button Classes="dialog" MinWidth="0" Width="48" Height="48" Padding="0" CornerRadius="24"
                          Background="{Binding Brush}" AutomationProperties.Name="{Binding Hex}"
                          BorderBrush="#E8EAF0" BorderThickness="{Binding IsSelected, Converter={x:Static local:Converters.SelectedBorder}}"
                          Command="{Binding $parent[Window].((local:LauncherViewModel)DataContext).PickColorCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding NewProfileError}" Foreground="#FF6B6B" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
              <Button Classes="dialog" Content="Abbrechen" Command="{Binding BackCommand}" />
              <Button Classes="dialog accent" Content="Anlegen" Command="{Binding CreateProfileCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding ShowPower}" x:Name="PowerDialog" Background="#1A1E26" CornerRadius="16"
                Padding="36,30" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Text="PC" FontSize="28" FontWeight="Bold" Foreground="#E8EAF0" />
            <Button Classes="dialog" Content="Herunterfahren" Command="{Binding ShutDownCommand}" HorizontalAlignment="Stretch" />
            <Button Classes="dialog" Content="Neu starten" Command="{Binding RestartCommand}" HorizontalAlignment="Stretch" />
            <Button Classes="dialog" Content="Abmelden" Command="{Binding LogOffCommand}" HorizontalAlignment="Stretch" />
            <Button Classes="dialog" Content="Abbrechen" Command="{Binding BackCommand}" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Border>

        <!-- Profil einrichten -->
        <Border IsVisible="{Binding ShowEditProfile}" x:Name="EditProfileDialog" Background="#1A1E26" CornerRadius="16"
                Padding="36,30" HorizontalAlignment="Center" VerticalAlignment="Center" Width="640" MaxHeight="640">
          <ScrollViewer>
            <StackPanel Spacing="16">
              <TextBlock Text="{Binding EditTitle}" FontSize="28" FontWeight="Bold" Foreground="#E8EAF0" />

              <TextBlock Text="Farbe" Foreground="#9AA3B2" />
              <ItemsControl ItemsSource="{Binding Colors}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:ColorChoice">
                    <Button Classes="dialog" MinWidth="0" Width="44" Height="44" Padding="0" CornerRadius="22"
                            Background="{Binding Brush}" AutomationProperties.Name="{Binding Hex}"
                            BorderBrush="#E8EAF0" BorderThickness="{Binding IsSelected, Converter={x:Static local:Converters.SelectedBorder}}"
                            Command="{Binding $parent[Window].((local:LauncherViewModel)DataContext).PickColorCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Hintergrund (Gaming-Themes)" Foreground="#9AA3B2" />
              <ItemsControl ItemsSource="{Binding Themes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:ThemeChoice">
                    <Button Classes="dialog" MinWidth="0" Width="92" Height="58" Padding="0" Margin="0,0,10,10" CornerRadius="8"
                            Background="{Binding Preview}" AutomationProperties.Name="{Binding Name}"
                            BorderBrush="#E8EAF0" BorderThickness="{Binding IsSelected, Converter={x:Static local:Converters.SelectedBorder}}"
                            Command="{Binding $parent[Window].((local:LauncherViewModel)DataContext).PickThemeCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#E8EAF0" VerticalAlignment="Bottom"
                                 Margin="6,0,0,4" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="dialog" Content="Eigenes Hintergrundbild …" Command="{Binding PickBackgroundCommand}" />
                <Button Classes="dialog" Content="Bild entfernen" Command="{Binding RemoveBackgroundCommand}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="dialog" Content="Profilbild (Avatar) …" Command="{Binding PickAvatarCommand}" />
                <Button Classes="dialog" Content="Avatar entfernen" Command="{Binding RemoveAvatarCommand}" />
              </StackPanel>

              <TextBlock Text="Passwort (schützt nur die Profilauswahl, kein Windows-Login)" Foreground="#9AA3B2" />
              <TextBox Text="{Binding EditPassword}" PasswordChar="●" PlaceholderText="Neues Passwort (leer lassen = unverändert)" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="dialog" Content="Passwort entfernen" IsVisible="{Binding EditHasPassword}"
                        Command="{Binding RemovePasswordCommand}" />
              </StackPanel>

              <TextBlock Text="{Binding EditMessage}" Foreground="#3DDC84" />
              <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <Button Classes="dialog" Content="Schließen" Command="{Binding BackCommand}" />
                <Button Classes="dialog accent" Content="Speichern" Command="{Binding SaveEditProfileCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Panel>
    </Panel>

    <!-- Leiste -->
    <Border x:Name="Bar" Grid.Row="1" Background="#15181E" Padding="14,8">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
        <Button Classes="bar" Command="{Binding RequestHelpCommand}" AutomationProperties.Name="Hilfe anfordern">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="?" FontWeight="Bold" Foreground="#4C8DFF" />
            <TextBlock Text="{Binding HelpText}" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="16,0" VerticalAlignment="Center">
          <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="#9AA3B2" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{Binding NetworkText}" FontSize="13" Foreground="#9AA3B2" Margin="12,0"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasAudio}" Margin="8,0">
          <Button Classes="bar" Command="{Binding ToggleMuteCommand}" AutomationProperties.Name="Ton an oder aus" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                  Content="{Binding Muted, Converter={x:Static local:Converters.MuteIcon}}" />
          <Slider Width="140" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center"
                  AutomationProperties.Name="Lautstärke" />
        </StackPanel>
        <StackPanel Grid.Column="5" Margin="12,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Clock}" FontSize="18" FontWeight="SemiBold" Foreground="#E8EAF0" HorizontalAlignment="Right" />
          <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="#9AA3B2" HorizontalAlignment="Right" />
        </StackPanel>
        <Button Grid.Column="6" Classes="bar" Content="&#xE7E8;" FontSize="18" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Command="{Binding OpenPowerCommand}"
                AutomationProperties.Name="Ausschalten" ToolTip.Tip="Herunterfahren, Neustart, Abmelden" />
      </Grid>
    </Border>
  </Grid>
</Window>
