<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MorniLAN.Launcher.MainWindow"
        Title="MorniLAN"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115">
  <!-- Platzhalter für Meilenstein 1. Vollbild, Kacheln und Leiste folgen ab Meilenstein 4/5. -->
  <Grid RowDefinitions="*,Auto">
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <TextBlock Text="MorniLAN" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center"
                 Foreground="#E8EAF0" />
      <TextBlock Text="Launcher – deine freigegebenen Apps und Spiele erscheinen hier."
                 FontSize="18" HorizontalAlignment="Center" Foreground="#9AA3B2" />
    </StackPanel>
    <TextBlock x:Name="VersionText" Grid.Row="1" Margin="16" HorizontalAlignment="Right"
               FontSize="12" Foreground="#5C6575" />
  </Grid>
</Window>
