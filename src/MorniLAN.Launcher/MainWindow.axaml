<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MorniLAN.Launcher.MainWindow"
        Title="MorniLAN"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115">
  <!-- Kacheln mit freigegebenen Apps folgen ab Meilenstein 4/5. Bis dahin: Status und Pairing-Code. -->
  <Grid RowDefinitions="*,Auto">
    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
      <TextBlock Text="MorniLAN" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center"
                 Foreground="#E8EAF0" />
      <TextBlock x:Name="Subtitle" Text="Launcher – deine freigegebenen Apps und Spiele erscheinen hier."
                 FontSize="18" HorizontalAlignment="Center" Foreground="#9AA3B2" />

      <!-- Pairing-Karte, nur solange der PC noch nicht gekoppelt ist -->
      <Border x:Name="PairingCard" IsVisible="False" Margin="0,28,0,0" Padding="32,24" CornerRadius="14"
              Background="#1A1E26" BorderBrush="#4C8DFF" BorderThickness="1" HorizontalAlignment="Center">
        <StackPanel Spacing="10" HorizontalAlignment="Center">
          <TextBlock Text="Diesen PC koppeln" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                     Foreground="#E8EAF0" />
          <TextBlock x:Name="PairingHint" FontSize="15" HorizontalAlignment="Center" Foreground="#9AA3B2"
                     TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
          <TextBlock x:Name="PairingCode" FontSize="64" FontWeight="Bold" FontFamily="Consolas, monospace"
                     HorizontalAlignment="Center" Foreground="#E8EAF0" LetterSpacing="4" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Statusleiste -->
    <Border Grid.Row="1" Background="#15181E" Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#5C6575" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Margin="10,0" VerticalAlignment="Center" FontSize="13"
                   Foreground="#9AA3B2" Text="Verbinde mit dem MorniLAN-Dienst …" />
        <TextBlock x:Name="VersionText" Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="#5C6575" />
      </Grid>
    </Border>
  </Grid>
</Window>
