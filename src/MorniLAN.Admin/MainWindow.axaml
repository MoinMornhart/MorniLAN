<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MorniLAN.Admin.ViewModels"
        xmlns:platform="using:MorniLAN.Admin.Platform"
        x:Class="MorniLAN.Admin.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="MorniLAN Admin"
        Icon="avares://MorniLAN.Admin/Assets/mornilan.ico"
        Width="1200" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1A1E26" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.pending">
      <Setter Property="BorderBrush" Value="#4C8DFF" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.warning">
      <Setter Property="BorderBrush" Value="#E8B04B" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9AA3B2" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#5C6575" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <DataTemplate x:Key="DiagRow" x:DataType="vm:DiagnosticRow">
      <Grid ColumnDefinitions="Auto,260,*" Margin="0,3">
        <Ellipse Width="9" Height="9" Margin="0,0,12,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
        <TextBlock Grid.Column="1" Text="{Binding Label}" Classes="muted" TextWrapping="Wrap" Margin="0,0,12,0" />
        <SelectableTextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0" Background="#15181E" Padding="12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="8,8,8,20">
          <TextBlock Text="MorniLAN" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Admin-Panel" FontSize="12" Foreground="#9AA3B2" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="8" FontSize="11" Foreground="#5C6575" Text="{Binding Version}" />
        <ListBox SelectedIndex="{Binding SelectedNavIndex}" Background="Transparent">
          <ListBoxItem Content="Übersicht" />
          <ListBoxItem Content="Freigaben" />
          <ListBoxItem Content="Fernzugriff" />
          <ListBoxItem Content="Aktionen" />
          <ListBoxItem Content="Diagnose" />
          <ListBoxItem Content="Einstellungen" />
        </ListBox>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Column="1">
      <Panel Margin="32">

        <!-- Übersicht -->
        <StackPanel Spacing="16" IsVisible="{Binding IsOverview}">
          <TextBlock Text="Übersicht" FontSize="28" FontWeight="SemiBold" />

          <!-- Hilfe-Anfragen aus dem Launcher -->
          <ItemsControl ItemsSource="{Binding HelpNotices}" IsVisible="{Binding HasHelpNotices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HelpNoticeViewModel">
                <Border Background="#3A2E17" BorderBrush="#E8B04B" BorderThickness="1" CornerRadius="10" Padding="16,12"
                        Margin="0,0,0,8">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="?" FontSize="22" FontWeight="Bold" Foreground="#E8B04B" VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                      <TextBlock Text="{Binding Time}" Classes="muted" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Erledigt"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DismissHelpCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Classes="card" Padding="16">
            <Grid ColumnDefinitions="Auto,*">
              <Ellipse Width="10" Height="10" Margin="0,5,12,0" VerticalAlignment="Top" Fill="{Binding ServerBrush}" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{Binding ServerStatus}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ServerDetails}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Update für das Panel selbst -->
          <Border Classes="card pending" IsVisible="{Binding AdminUpdateAvailable}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Update verfügbar" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="{Binding AdminUpdateText}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Classes="accent"
                      Content="Jetzt aktualisieren" Command="{Binding InstallAdminUpdateCommand}" />
            </Grid>
          </Border>

          <!-- Firewall fehlt: Hinweis mit Knopf -->
          <Border Classes="card warning" IsVisible="{Binding FirewallMissing}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Firewall einrichten" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="{Binding FirewallText}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Erlaubt werden nur Geräte aus deinem Heimnetz und aus Tailscale. Windows fragt einmal nach Admin-Rechten." />
              </StackPanel>
              <Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Classes="accent"
                      Content="Firewall einrichten" Command="{Binding SetupFirewallCommand}" />
            </Grid>
          </Border>

          <ItemsControl ItemsSource="{Binding PendingPairings}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PendingPairingViewModel">
                <Border Classes="card pending">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="Gib den Pairing-Code ein, den der Agent auf dem PC anzeigt:" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBox Text="{Binding Code}" PlaceholderText="XXXX-XXXX" Width="170" MaxLength="12"
                               FontFamily="Consolas" FontSize="18" />
                      <Button Content="Koppeln" Classes="accent" Command="{Binding PairCommand}" IsDefault="True" />
                      <Button Content="Ablehnen" Command="{Binding RejectCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Error}" Foreground="#FF6B6B" IsVisible="{Binding HasError}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Gekoppelte PCs" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
          <TextBlock IsVisible="{Binding HasNoDevices}" Classes="muted" TextWrapping="Wrap"
                     Text="Noch kein PC gekoppelt. Installiere „MorniLAN für Geräte“ auf dem PC. Er findet dieses Panel im Heimnetz von selbst und zeigt einen Pairing-Code an." />

          <ItemsControl ItemsSource="{Binding Devices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DeviceViewModel">
                <Border Classes="card">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Ellipse Width="12" Height="12" Margin="0,8,14,0" VerticalAlignment="Top"
                             Fill="{Binding StatusBrush}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding StatusText}" />
                      <TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" VerticalAlignment="Top" Content="{Binding UnpairText}"
                            Command="{Binding UnpairCommand}" />

                    <!-- Update des PCs -->
                    <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0"
                          IsVisible="{Binding HasUpdateText}">
                      <TextBlock Text="{Binding UpdateText}" Foreground="{Binding UpdateBrush}" TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                      <Button Grid.Column="1" Margin="12,0,0,0" Classes="accent" Content="Jetzt aktualisieren"
                              IsVisible="{Binding CanUpdate}" Command="{Binding InstallUpdateCommand}" />
                    </Grid>

                    <UniformGrid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Columns="3" Margin="0,14,0,0">
                      <StackPanel Spacing="2">
                        <TextBlock Text="CPU" Classes="label" />
                        <TextBlock Text="{Binding Cpu}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="ARBEITSSPEICHER" Classes="label" />
                        <TextBlock Text="{Binding Ram}" />
                      </StackPanel>
                      <StackPanel Spacing="2">
                        <TextBlock Text="SYSTEMLAUFWERK" Classes="label" />
                        <TextBlock Text="{Binding Disk}" />
                      </StackPanel>
                    </UniformGrid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Neuen PC hinzufügen: Adressen zum Abschreiben -->
          <Border Classes="card" Margin="0,8,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="Neuen PC hinzufügen" Classes="h2" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="1. Auf dem PC „MorniLAN für Geräte“ installieren. 2. Im Heimnetz findet er dieses Panel von selbst. 3. Den Code aus seinem Fenster oben eingeben." />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Klappt die Suche nicht, z. B. über Tailscale oder in einem anderen Netz: Trag im Geräte-Setup bei „Adresse des Admin-PCs“ eine dieser Adressen ein." />
              <ItemsControl ItemsSource="{Binding Addresses}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AddressItem">
                    <Border Background="#15181E" CornerRadius="8" Padding="12,8" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <StackPanel Spacing="0">
                          <TextBlock Text="{Binding Kind}" Classes="label" />
                          <SelectableTextBlock Text="{Binding Address}" FontFamily="Consolas, monospace" FontSize="15" />
                        </StackPanel>
                        <Button Content="Kopieren" VerticalAlignment="Center" FontSize="12"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyCommand}"
                                CommandParameter="{Binding Address}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Freigaben: was auf dem PC installiert ist, mit Schalter je Eintrag -->
        <StackPanel Spacing="16" IsVisible="{Binding IsApps}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Freigaben" FontSize="28" FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding Apps.RefreshMessage}" Classes="muted" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Apps.Devices}" SelectedItem="{Binding Apps.SelectedDevice}" MinWidth="160"
                        PlaceholderText="PC wählen" />
              <Button Content="Neu einlesen" Command="{Binding Apps.RefreshCommand}" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Alles, was auf dem PC installiert ist. Der Schalter legt fest, was im Launcher erscheint. Standard: alles frei, du sperrst gezielt. (Wirklich blockiert wird Gesperrtes ab Meilenstein 6.)" />

          <!-- Profile des PCs -->
          <Border Classes="card" IsVisible="{Binding Apps.HasDevice}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Profile" Classes="h2" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Apps.ProfileCreationAllowed}"
                              OnContent="Am PC neue Profile anlegen erlaubt" OffContent="Am PC neue Profile anlegen gesperrt" />
              </Grid>
              <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !Apps.HasProfiles}"
                         Text="Noch keine Profile. Beim Start fragt der Launcher „Wer spielt?“, dort lassen sich Profile anlegen (oder hier)." />
              <ItemsControl ItemsSource="{Binding Apps.ProfileRows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileRowViewModel">
                    <Border Background="#15181E" CornerRadius="10" Padding="12,8" Margin="0,0,10,10">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="32" Height="32" CornerRadius="16" Background="{Binding Brush}">
                          <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="#0F1115"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Details}" Classes="label" />
                        </StackPanel>
                        <Button Content="Passwort zurücksetzen" VerticalAlignment="Center" IsVisible="{Binding HasPassword}"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Apps.ResetPasswordCommand}"
                                CommandParameter="{Binding}" />
                        <Button Content="Löschen" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Apps.DeleteProfileCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox Width="220" Text="{Binding Apps.NewProfileName}" PlaceholderText="Neues Profil, z. B. Lena" />
                <Button Content="Profil anlegen" Command="{Binding Apps.CreateProfileCommand}" />
                <TextBlock Text="{Binding Apps.ProfileMessage}" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
              <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Apps.HasProfiles}">
                <ComboBox ItemsSource="{Binding Apps.Scopes}" SelectedItem="{Binding Apps.SelectedScope}" MinWidth="200"
                          ToolTip.Tip="Für wen die Schalter unten gelten" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0" Text="{Binding Apps.ScopeHint}" Classes="muted"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- Windows-Sperren: welche Konten, welche Bereiche -->
          <Border Classes="card" IsVisible="{Binding Apps.HasDevice}">
            <StackPanel Spacing="12">
              <TextBlock Text="Windows-Sperren" Classes="h2" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Wähle, welche Konten eingeschränkt werden. Nicht angehakte Konten (und Administratorkonten) nutzen Windows ganz normal. Dein eigenes Admin-Konto wird nie eingeschränkt." />
              <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !Apps.HasAccounts}"
                         Text="Der PC hat seine Konten noch nicht gemeldet. Sobald er online ist, erscheinen sie hier." />

              <ItemsControl ItemsSource="{Binding Apps.Accounts}" IsVisible="{Binding Apps.HasAccounts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AccountRowViewModel">
                    <Border Background="#15181E" CornerRadius="10" Padding="12,10" Margin="0,0,10,10" MinWidth="240">
                      <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Role}" Classes="label" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsRestricted}" IsEnabled="{Binding CanRestrict}"
                                        OnContent="eingeschränkt" OffContent="normal" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanRestrict}">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Launcher als Desktop" />
                            <TextBlock Text="kein Windows-Desktop, kein Entkommen" Classes="label" />
                          </StackPanel>
                          <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsKiosk}" IsEnabled="{Binding CanRestrict}"
                                        OnContent="Desktop" OffContent="aus" />
                        </Grid>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="Gesperrte Windows-Bereiche (in den eingeschränkten Konten)" Classes="muted"
                         IsVisible="{Binding Apps.HasAccounts}" />
              <ItemsControl ItemsSource="{Binding Apps.Areas}" IsVisible="{Binding Apps.HasAccounts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AreaRowViewModel">
                    <ToggleSwitch Margin="0,0,20,0" IsChecked="{Binding IsBlocked}" OnContent="{Binding Name}"
                                  OffContent="{Binding Name}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Apps.HasAccounts}">
                <Ellipse Width="10" Height="10" Fill="{Binding Apps.RestrictionBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding Apps.RestrictionStatus}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Grid.Column="2" Content="Sperren jetzt aktivieren" Command="{Binding Apps.ApplyRestrictionsCommand}" />
              </Grid>
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding Apps.HasAccounts}"
                         Text="Notfall: Am PC gibt es im Startmenü „MorniLAN Notfall-Entsperrung“. Damit hebt man mit Administrator-Passwort alle Sperren auf, auch ohne Panel. App Control (harte Windows-Sperre) kommt als eigener Schritt mit Prüfmodus." />
            </StackPanel>
          </Border>

          <!-- Stand auf dem PC, Sammel-Knöpfe, eigener Eintrag -->
          <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Apps.HasDevice}">
            <Ellipse Width="10" Height="10" Fill="{Binding Apps.PolicyBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding Apps.PolicyStatus}" VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <Button Content="Sichtbare freigeben" Command="{Binding Apps.AllowVisibleCommand}"
                      ToolTip.Tip="Alle Einträge, die Suche und Filter gerade zeigen" />
              <Button Content="Sichtbare sperren" Command="{Binding Apps.BlockVisibleCommand}"
                      ToolTip.Tip="Alle Einträge, die Suche und Filter gerade zeigen" />
              <Button Content="Eigener Eintrag …" Command="{Binding Apps.ToggleCustomFormCommand}" />
            </StackPanel>
          </Grid>

          <Border Classes="card" IsVisible="{Binding Apps.ShowCustomForm}">
            <StackPanel Spacing="10">
              <TextBlock Text="Eigenen Eintrag hinzufügen" Classes="h2" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Für Programme, die MorniLAN nicht selbst findet. Der Pfad gilt auf dem verwalteten PC, z. B. C:\Spiele\MeinSpiel\spiel.exe. Das Icon holt sich der PC aus der Datei." />
              <Grid ColumnDefinitions="*,2*,*" ColumnSpacing="10">
                <TextBox Text="{Binding Apps.CustomName}" PlaceholderText="Name, z. B. Minecraft" />
                <TextBox Grid.Column="1" Text="{Binding Apps.CustomPath}" PlaceholderText="C:\Pfad\zum\Programm.exe" />
                <TextBox Grid.Column="2" Text="{Binding Apps.CustomArguments}" PlaceholderText="Argumente (optional)" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Hinzufügen" Classes="accent" Command="{Binding Apps.AddCustomCommand}" />
                <Button Content="Abbrechen" Command="{Binding Apps.ToggleCustomFormCommand}" />
                <TextBlock Text="{Binding Apps.CustomError}" Foreground="#FF6B6B" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Aufräumen: unnötige Apps erkennen und auf Bestätigung ausblenden -->
          <Border Classes="card" IsVisible="{Binding Apps.HasDevice}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Aufräumen" Classes="h2" />
                  <TextBlock Text="{Binding Apps.SuggestionSummary}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" VerticalAlignment="Center" IsVisible="{Binding Apps.HasSuggestions}"
                        Content="Vorschläge ansehen" Command="{Binding Apps.ToggleSuggestionsCommand}" />
              </Grid>

              <StackPanel Spacing="8" IsVisible="{Binding Apps.ShowSuggestions}">
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Angehakte Einträge werden nur aus der Ansicht genommen (nicht gesperrt, bleiben installiert). Einzelne kannst du abwählen." />
                <Border Background="#15181E" CornerRadius="10" Padding="6" MaxHeight="280">
                  <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Apps.Suggestions}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SuggestionRowViewModel">
                          <CheckBox IsChecked="{Binding IsChecked}" Margin="4,2">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding Details}" Classes="label" />
                            </StackPanel>
                          </CheckBox>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Alle an/aus" Command="{Binding Apps.SelectAllSuggestionsCommand}" />
                  <Button Content="Ausgewählte ausblenden" Classes="accent" Command="{Binding Apps.HideSelectedCommand}" />
                  <TextBlock Text="{Binding Apps.CleanupMessage}" Classes="muted" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding Apps.HasHidden}">
                <ToggleSwitch IsChecked="{Binding Apps.ShowHidden}" OnContent="Ausgeblendete anzeigen" OffContent="Ausgeblendete anzeigen" />
                <Button Grid.Column="2" Content="Alle wieder einblenden" Command="{Binding Apps.UnhideAllCommand}" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBox Text="{Binding Apps.SearchText}" PlaceholderText="Suchen nach Name oder Hersteller …" />
            <ComboBox Grid.Column="1" Margin="10,0,0,0" SelectedIndex="{Binding Apps.FilterIndex}" MinWidth="150">
              <ComboBoxItem Content="Alle" />
              <ComboBoxItem Content="Spiele" />
              <ComboBoxItem Content="Programme" />
              <ComboBoxItem Content="Store-Apps" />
              <ComboBoxItem Content="Gesperrt" />
            </ComboBox>
            <ToggleSwitch Grid.Column="2" Margin="16,0,0,0" IsChecked="{Binding Apps.ShowSystem}"
                          OnContent="Systemkomponenten anzeigen" OffContent="Systemkomponenten anzeigen" />
          </Grid>
          <TextBlock Text="{Binding Apps.Summary}" Classes="muted" FontSize="12" />

          <TextBlock IsVisible="{Binding Apps.IsEmpty}" Text="{Binding Apps.EmptyText}" Classes="muted" TextWrapping="Wrap" />

          <!-- Spiele als Cover-Kacheln -->
          <StackPanel Spacing="10" IsVisible="{Binding Apps.HasGames}">
            <TextBlock Text="Spiele" Classes="h2" />
            <ItemsControl ItemsSource="{Binding Apps.Games}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AppItemViewModel">
                  <Border Width="150" Margin="0,0,14,14" CornerRadius="8" Background="#1A1E26" ClipToBounds="True"
                          ToolTip.Tip="{Binding Details}">
                    <StackPanel Opacity="{Binding Opacity}">
                      <Panel Height="225" Background="#15181E">
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}" />
                        <StackPanel IsVisible="{Binding !HasCover}" Spacing="10" Margin="12"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                          <Image Source="{Binding Icon}" Width="48" Height="48" IsVisible="{Binding HasIcon}" />
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                        <Border Background="{Binding BadgeBrush}" CornerRadius="4" Padding="6,2" Margin="6"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="White" />
                        </Border>
                      </Panel>
                      <StackPanel Margin="10,8" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <ToggleSwitch IsChecked="{Binding IsAllowed}" OnContent="freigegeben" OffContent="gesperrt" AutomationProperties.Name="{Binding Name}"
                                      FontSize="12" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Programme und Store-Apps als Liste -->
          <StackPanel Spacing="10" IsVisible="{Binding Apps.HasApps}">
            <TextBlock Text="Programme und Apps" Classes="h2" />
            <Border Classes="card" Padding="8">
              <ItemsControl ItemsSource="{Binding Apps.Apps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AppItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="8,6">
                      <Panel Width="36" Height="36" Margin="0,0,14,0" VerticalAlignment="Center" Opacity="{Binding Opacity}">
                        <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="32" Height="32" />
                        <Border IsVisible="{Binding !HasIcon}" CornerRadius="8" Background="#262B35">
                          <TextBlock Text="{Binding Initial}" FontWeight="Bold" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Foreground="#9AA3B2" />
                        </Border>
                      </Panel>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Opacity="{Binding Opacity}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" Classes="label" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Border Grid.Column="2" Margin="12,0,0,0" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                              Background="{Binding BadgeBrush}">
                        <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="White" />
                      </Border>
                      <Button Grid.Column="3" Margin="10,0,0,0" Content="Entfernen" IsVisible="{Binding IsCustom}"
                              VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Apps.RemoveCustomCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="4" Margin="10,0,0,0" Content="{Binding HideButtonText}" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Apps.ToggleHiddenCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Nur aus Ansicht und Launcher nehmen (nicht sperren)" />
                      <ToggleSwitch Grid.Column="5" Margin="12,0,0,0" MinWidth="130" IsChecked="{Binding IsAllowed}" AutomationProperties.Name="{Binding Name}"
                                    OnContent="freigegeben" OffContent="gesperrt" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </StackPanel>

        <!-- Fernzugriff -->
        <StackPanel Spacing="16" IsVisible="{Binding IsRemote}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Fernzugriff" FontSize="28" FontWeight="SemiBold" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Remote.Devices}" SelectedItem="{Binding Remote.SelectedDevice}"
                      MinWidth="160" PlaceholderText="PC wählen" />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Auf den Bildschirm des PCs zugreifen (Streaming mit Sunshine + Moonlight). Der Freund sieht am PC immer deutlich, dass gerade zugegriffen wird." />

          <Border Classes="card" IsVisible="{Binding Remote.HasDevice}">
            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="Auto,*">
                <Ellipse Width="10" Height="10" Fill="{Binding Remote.StatusBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding Remote.StatusText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </Grid>
              <TextBlock Text="{Binding Remote.MoonlightHint}" FontWeight="SemiBold" TextWrapping="Wrap"
                         IsVisible="{Binding Remote.IsActive}" />

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Verbinden" Classes="accent" Command="{Binding Remote.ConnectCommand}"
                        IsVisible="{Binding Remote.CanConnect}" />
                <Button Content="Moonlight installieren" Command="{Binding Remote.InstallMoonlightCommand}"
                        IsVisible="{Binding Remote.MoonlightMissing}"
                        ToolTip.Tip="Einmalig auf diesem Admin-PC – danach startet der Fernzugriff automatisch" />
                <Button Content="Trennen" Command="{Binding Remote.DisconnectCommand}" IsVisible="{Binding Remote.IsActive}" />
                <ToggleSwitch IsChecked="{Binding Remote.InputLocked}" IsVisible="{Binding Remote.IsActive}"
                              Command="{Binding Remote.ToggleInputLockCommand}"
                              OnContent="Maus/Tastatur gesperrt" OffContent="Maus/Tastatur frei" />
              </StackPanel>

              <ToggleSwitch IsChecked="{Binding Remote.AllowWithoutConsent}"
                            OnContent="Ohne Rückfrage erlauben (startet sofort)" OffContent="Immer am PC nachfragen" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Ist das Häkchen aus, erscheint am PC des Freundes eine Abfrage „Erlauben/Ablehnen“. Mit Häkchen startet der Fernzugriff sofort – am PC bleibt der deutliche Hinweis trotzdem sichtbar." />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Aktionen -->
        <StackPanel Spacing="16" IsVisible="{Binding IsActions}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Aktionen" FontSize="28" FontWeight="SemiBold" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Actions.Devices}" SelectedItem="{Binding Actions.SelectedDevice}"
                      MinWidth="160" PlaceholderText="PC wählen" />
          </Grid>
          <TextBlock Text="{Binding Actions.OfflineHint}" Classes="muted" IsVisible="{Binding !Actions.IsOnline}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Actions.ActionError}" Foreground="#FF6B6B" IsVisible="{Binding Actions.HasDevice}" />

          <Border Classes="card" IsVisible="{Binding Actions.HasDevice}">
            <StackPanel Spacing="10">
              <TextBlock Text="Programm installieren" Classes="h2" />
              <TextBox Text="{Binding Actions.SearchText}" PlaceholderText="Programm suchen (z. B. Discord) …" />
              <TextBlock Text="Suche läuft …" Classes="muted" IsVisible="{Binding Actions.Searching}" />
              <ItemsControl ItemsSource="{Binding Actions.SearchResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="platform:WingetHit">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Id}" Classes="label" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Installieren" Classes="accent" Margin="0,0,8,0"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Actions.InstallCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2" Content="Deinstallieren"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).Actions.UninstallCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding Actions.HasDevice}">
            <StackPanel Spacing="10">
              <TextBlock Text="Von einer Adresse installieren" Classes="h2" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Direkter Link auf eine .exe oder .msi. MorniLAN lädt sie auf den PC und installiert sie still. Nur Quellen nutzen, denen du vertraust." />
              <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding Actions.UrlAddress}" PlaceholderText="https://…/setup.exe" />
                <TextBox Grid.Column="1" Text="{Binding Actions.UrlName}" PlaceholderText="Name" />
                <Button Grid.Column="2" Content="Installieren" Command="{Binding Actions.InstallFromUrlCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding Actions.HasDevice}">
            <StackPanel Spacing="10">
              <TextBlock Text="Nachricht an den Freund" Classes="h2" />
              <TextBox Text="{Binding Actions.MessageTitle}" PlaceholderText="Titel (optional)" />
              <TextBox Text="{Binding Actions.MessageText}" PlaceholderText="Nachricht …" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
              <Button Content="Senden" HorizontalAlignment="Left" Command="{Binding Actions.SendMessageCommand}" />
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding Actions.HasDevice}">
            <StackPanel Spacing="10">
              <TextBlock Text="PC steuern" Classes="h2" />
              <TextBlock Classes="muted" Text="Der PC zeigt vorher eine Minute lang eine Warnung an." />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Neu starten" Command="{Binding Actions.RestartCommand}" />
                <Button Content="Herunterfahren" Command="{Binding Actions.ShutDownCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card" IsVisible="{Binding Actions.HasDevice}">
            <StackPanel Spacing="8">
              <TextBlock Text="Verlauf" Classes="h2" />
              <TextBlock Text="Noch keine Aktionen." Classes="muted" IsVisible="{Binding !Actions.History.Count}" />
              <ItemsControl ItemsSource="{Binding Actions.History}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActionEntryViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                      <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding Description}" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding StateText}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Time}" Classes="label" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Diagnose -->
        <StackPanel Spacing="16" IsVisible="{Binding IsDiagnostics}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Diagnose" FontSize="28" FontWeight="SemiBold" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <TextBlock Text="{Binding Diagnostics.LastRefresh}" Classes="muted" VerticalAlignment="Center" />
              <Button Content="Aktualisieren" Command="{Binding Diagnostics.RefreshCommand}" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap"
                     Text="Hier siehst du ohne Logdateien und Befehle, ob alles bereit ist. Rot heißt: da hakt es." />

          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Server" Classes="h2" />
              <ItemsControl ItemsSource="{Binding Diagnostics.ServerRows}" ItemTemplate="{StaticResource DiagRow}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Firewall" Classes="h2" />
                <Button Grid.Column="1" Content="Firewall einrichten" Command="{Binding SetupFirewallCommand}" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Diagnostics.FirewallRows}" ItemTemplate="{StaticResource DiagRow}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Netzwerk dieses PCs" Classes="h2" />
              <ItemsControl ItemsSource="{Binding Diagnostics.NetworkRows}" ItemTemplate="{StaticResource DiagRow}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Gekoppelte PCs" Classes="h2" />
              <ItemsControl ItemsSource="{Binding Diagnostics.DeviceRows}" ItemTemplate="{StaticResource DiagRow}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Letzte Log-Einträge" Classes="h2" />
              <Border Background="#0F1115" CornerRadius="6" Padding="12">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" MaxHeight="360">
                  <SelectableTextBlock Text="{Binding Diagnostics.LogText}" FontFamily="Consolas, monospace" FontSize="12"
                                       Foreground="#9AA3B2" />
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Einstellungen -->
        <StackPanel Spacing="16" IsVisible="{Binding IsSettings}">
          <TextBlock Text="Einstellungen" FontSize="28" FontWeight="SemiBold" />
          <Border Classes="card">
            <StackPanel Spacing="14">
              <ToggleSwitch IsChecked="{Binding StartWithWindows}" OnContent="Mit Windows starten" OffContent="Mit Windows starten" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Das Panel startet beim Anmelden unsichtbar im Infobereich, damit PCs jederzeit online gehen können." />
              <ToggleSwitch IsChecked="{Binding KeepRunningInTray}" OnContent="Beim Schließen im Infobereich weiterlaufen"
                            OffContent="Beim Schließen im Infobereich weiterlaufen" />
              <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                         Text="Das X schließt dann nur das Fenster. Ganz beenden über das MorniLAN-Symbol unten rechts → Beenden." />
              <TextBlock Text="{Binding SettingsMessage}" Foreground="#3DDC84" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="Einrichtung" Classes="h2" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Der geführte Ablauf hilft bei Firewall und erstem Pairing. Du kannst ihn jederzeit erneut starten." />
              <Button Content="Einrichtung starten" HorizontalAlignment="Left" Command="{Binding StartSetupCommand}" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="Updates" Classes="h2" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Das Panel sucht beim Start und alle 6 Stunden auf GitHub nach neuen Versionen, Betas eingeschlossen. Die verwalteten PCs aktualisieren sich selbst, aber nie während eines Spiels; über die Karte des PCs geht es auch sofort." />
              <TextBlock Text="{Binding Version}" />
              <TextBlock Text="{Binding UpdateStatus}" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Nach Updates suchen" Command="{Binding CheckForUpdatesCommand}" />
                <Button Content="Jetzt aktualisieren" Classes="accent" IsVisible="{Binding AdminUpdateAvailable}"
                        Command="{Binding InstallAdminUpdateCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

      </Panel>
    </ScrollViewer>

    <!-- Einrichtungs-Assistent (First-Run): führt durch Firewall und erstes Pairing -->
    <Border Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding ShowSetup}" ZIndex="100" Background="#DD0F1115">
      <Border Classes="card" Width="660" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,18">
            <TextBlock Text="Einrichtung" Classes="h2" />
            <TextBlock Classes="label" Text="MorniLAN startklar machen" />
          </StackPanel>

          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,22,0,0">
            <Button Content="Überspringen" Command="{Binding FinishSetupCommand}" IsVisible="{Binding !IsSetupDone}" />
            <Button Grid.Column="2" Content="Zurück" Margin="0,0,8,0" Command="{Binding SetupBackCommand}"
                    IsVisible="{Binding !IsSetupWelcome}" />
            <Button Grid.Column="3" Content="Weiter" Classes="accent" Command="{Binding SetupNextCommand}"
                    IsVisible="{Binding !IsSetupDone}" />
            <Button Grid.Column="3" Content="Fertig" Classes="accent" Command="{Binding FinishSetupCommand}"
                    IsVisible="{Binding IsSetupDone}" />
          </Grid>

          <ScrollViewer>
            <Panel>
              <!-- Schritt 0: Willkommen -->
              <StackPanel Spacing="14" IsVisible="{Binding IsSetupWelcome}">
                <TextBlock Text="Willkommen 👋" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Mit MorniLAN gibst du den Gaming-PC eines Freundes frei und behältst den Überblick – Spiele, Sperren, Fernzugriff, alles aus diesem Panel." />
                <TextBlock TextWrapping="Wrap"
                           Text="Diese Einrichtung dauert etwa zwei Minuten und hat zwei Schritte:" />
                <StackPanel Spacing="6" Margin="8,0,0,0">
                  <TextBlock Text="1.  Firewall freigeben, damit andere PCs dieses Panel im Netz erreichen." TextWrapping="Wrap" />
                  <TextBlock Text="2.  Den ersten PC koppeln (einen kurzen Code eingeben)." TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Classes="label" TextWrapping="Wrap"
                           Text="Du kannst jederzeit „Überspringen“ und später unter Einstellungen erneut starten." />
              </StackPanel>

              <!-- Schritt 1: Firewall -->
              <StackPanel Spacing="14" IsVisible="{Binding IsSetupFirewall}">
                <TextBlock Text="Schritt 1 – Firewall" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Damit die Geräte dieses Panel im Heimnetz (und über Tailscale) finden, braucht Windows einmal eine Freigabe. Es fragt dabei nach Administrator-Rechten." />
                <Border Background="#15181E" CornerRadius="10" Padding="16">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding FirewallText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                    <Button Grid.Column="1" Classes="accent" Content="Firewall einrichten"
                            Command="{Binding SetupFirewallCommand}" IsVisible="{Binding FirewallMissing}" />
                    <TextBlock Grid.Column="1" Text="✓ erledigt" Foreground="#3DDC84"
                               VerticalAlignment="Center" IsVisible="{Binding !FirewallMissing}" />
                  </Grid>
                </Border>
                <TextBlock Classes="label" TextWrapping="Wrap"
                           Text="Schon freigegeben? Dann einfach auf „Weiter“." />
              </StackPanel>

              <!-- Schritt 2: Erstes Gerät koppeln -->
              <StackPanel Spacing="14" IsVisible="{Binding IsSetupPairing}">
                <TextBlock Text="Schritt 2 – Ersten PC koppeln" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Auf dem Gaming-PC „MorniLAN für Geräte“ installieren und starten. Er findet dieses Panel im Heimnetz von selbst und zeigt einen Code an. Diesen Code hier eingeben:" />

                <ItemsControl ItemsSource="{Binding PendingPairings}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PendingPairingViewModel">
                      <Border Classes="card pending">
                        <StackPanel Spacing="10">
                          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding Code}" PlaceholderText="XXXX-XXXX" Width="170" MaxLength="12"
                                     FontFamily="Consolas" FontSize="18" />
                            <Button Content="Koppeln" Classes="accent" Command="{Binding PairCommand}" IsDefault="True" />
                          </StackPanel>
                          <TextBlock Text="{Binding Error}" Foreground="#FF6B6B" IsVisible="{Binding HasError}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#15181E" CornerRadius="10" Padding="16" IsVisible="{Binding HasNoDevices}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="⏳ Warte auf den PC … sobald er sich meldet, erscheint hier sein Code-Feld." Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Classes="label" TextWrapping="Wrap"
                               Text="Klappt die Suche nicht (Tailscale/anderes Netz): Trag im Geräte-Setup bei „Adresse des Admin-PCs“ eine dieser Adressen ein:" />
                    <ItemsControl ItemsSource="{Binding Addresses}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AddressItem">
                          <Border Background="#0F1115" CornerRadius="8" Padding="10,6" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <StackPanel Spacing="0">
                                <TextBlock Text="{Binding Kind}" Classes="label" />
                                <SelectableTextBlock Text="{Binding Address}" FontFamily="Consolas, monospace" FontSize="14" />
                              </StackPanel>
                              <Button Content="Kopieren" VerticalAlignment="Center" FontSize="12"
                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CopyCommand}"
                                      CommandParameter="{Binding Address}" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Schritt 3: Fertig -->
              <StackPanel Spacing="14" IsVisible="{Binding IsSetupDone}">
                <TextBlock Text="Geschafft! 🎉" FontSize="22" FontWeight="SemiBold" Foreground="#3DDC84" />
                <TextBlock TextWrapping="Wrap"
                           Text="Der erste PC ist gekoppelt. Du siehst ihn jetzt in der Übersicht – mit Status, Freigaben, Fernzugriff und Aktionen." />
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="Weitere PCs fügst du genauso hinzu. Die Einrichtung kannst du unter Einstellungen jederzeit erneut starten." />
              </StackPanel>
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</Window>
